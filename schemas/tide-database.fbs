// Neaps tide database. One file holds every station: identity fields readable
// without touching prediction data, prediction data readable per station.
// See docs in the repo for the build-order requirement (constituents vectors
// are written together at the tail of the buffer, station tables together at
// the head) — the schema cannot express it, the builder and a locality test
// enforce it.

namespace neaps;

enum Kind : ubyte {
  Tide = 0,
  Current = 1,
}

enum StationType : ubyte {
  Reference = 0,
  Subordinate = 1,
}

enum DatumsSource : ubyte {
  Unknown = 0,
  Observed = 1,
  Harmonic = 2,
}

enum HeightOffsetType : ubyte {
  Ratio = 0,
  Fixed = 1,
}

// A harmonic constituent: an index into TideDatabase.constituent_names plus
// amplitude and phase. 12 bytes, contiguous in the vector. Float32 holds seven
// significant digits; sources publish three decimal places.
struct Constituent {
  name: ushort;
  amplitude: float;
  phase: float;
}

// A datum: an index into TideDatabase.datum_names plus its value.
struct Datum {
  name: ushort;
  value: float;
}

table Source {
  name: string;
  id: string;
  published_harmonics: bool;
  url: string;
}

table License {
  type: string;
  commercial_use: bool;
  url: string;
  notes: string;
}

// Subordinate-station tide offsets, applied to the reference station's
// predictions. Times are in minutes; heights are a ratio or a fixed amount
// depending on height_type.
table TideOffsets {
  reference: string (required);
  time_high: float;
  time_low: float;
  height_high: float;
  height_low: float;
  height_type: HeightOffsetType;
}

// Current-station data. No current data ships from this repo yet; the table
// gives downstream catalogs a place to write theirs through the builder.
// Directions are degrees true, speeds are knots, time offsets are minutes,
// speed ratios are unitless multipliers on the reference current.
table Current {
  flood_direction: float;
  ebb_direction: float;
  mean_flood_speed: float;
  mean_ebb_speed: float;
  // Station id of the tide station whose extremes this current pairs with.
  tide_station: string;
  min_before_flood: float;
  min_before_ebb: float;
  flood_time: float;
  ebb_time: float;
  flood_speed_ratio: float;
  ebb_speed_ratio: float;
}

table Station {
  // "<source>/<station id>", e.g. "noaa/9447130". The vector key: stations are
  // sorted by id so lookup is a binary search inside the buffer.
  id: string (key, required);
  name: string;
  kind: Kind;
  type: StationType;
  latitude: double;
  longitude: double;
  timezone: string;
  region: string;
  country: string;
  continent: string;
  // Alternate names and slugs for search.
  aliases: [string];

  constituents: [Constituent];
  datums: [Datum];
  // Index into TideDatabase.datum_names of the vertical reference (e.g. MLLW).
  // 65535 means no chart datum.
  chart_datum: ushort = 65535;
  datums_source: DatumsSource;
  // The period the harmonic constituents were computed over, "YYYY-MM-DD".
  epoch_start: string;
  epoch_end: string;
  offsets: TideOffsets;
  current: Current;

  source: Source;
  license: License;
  disclaimers: string;
}

table TideDatabase {
  // Version of the database that built the file (e.g. the package version).
  version: string;
  // Name tables for the struct vectors' ushort indexes.
  constituent_names: [string];
  datum_names: [string];
  // Sorted by id.
  stations: [Station];
}

root_type TideDatabase;
file_identifier "NEAP";
file_extension "neaps";
