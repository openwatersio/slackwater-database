{
  "name": "slackwater-database",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "sources/*"
  ],
  "scripts": {
    "build": "npm run build -w packages/database",
    "test": "npm run build -w packages/database && tsc -p tsconfig.node.json && npm test --workspaces --if-present",
    "check": "npm run lint && npm test && npm run validate",
    "stations": "npm run stations -w packages/stations",
    "validate": "npm run validate -w packages/stations",
    "pack:local": "node packages/database/scripts/pack-local.mjs",
    "lint": "prettier --check .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2"
  }
}
