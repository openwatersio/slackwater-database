{
  "name": "tide-database",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "sources/*"
  ],
  "scripts": {
    "build": "npm run build -w packages/database",
    "test": "npm run build -w packages/database && tsc -p tsconfig.node.json && npm run test -w packages/database -w packages/datums -w packages/harmonic-analysis -w packages/stations -w sources/noaa-current",
    "metadata:lock": "npm run metadata-lock -w packages/stations",
    "validate:database": "npm run validate-database -w packages/stations",
    "lint": "prettier --check .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "prettier": "^3.7.4",
    "typescript": "^7.0.2"
  }
}
