{
  "name": "@neaps/tide-database",
  "version": "0.9.0",
  "description": "A public database of tide and current stations",
  "keywords": [
    "tides",
    "currents",
    "harmonics",
    "database"
  ],
  "homepage": "https://openwaters.io/tides/database",
  "bugs": {
    "url": "https://github.com/openwatersio/tide-database/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openwatersio/tide-database.git",
    "directory": "packages/database"
  },
  "license": "MIT",
  "author": "Brandon Keepers <brandon@openwaters.io>",
  "type": "module",
  "main": "./dist/node/index.js",
  "module": "./dist/node/index.js",
  "types": "./dist/node/index.d.ts",
  "imports": {
    "#neaps.tcdb": {
      "browser": "./src/database/bytes.browser.ts",
      "default": "./src/database/bytes.node.ts"
    }
  },
  "exports": {
    ".": {
      "workerd": "./dist/worker/index.js",
      "worker": "./dist/worker/index.js",
      "browser": "./dist/browser/index.js",
      "node": "./dist/node/index.js",
      "default": "./dist/browser/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "generate": "node --experimental-transform-types scripts/generate-database.ts",
    "build": "npm run generate && tsdown && node scripts/copy-database.mjs && tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json && npm run smoke",
    "smoke": "node scripts/smoke.mjs",
    "prepare": "npm run build",
    "pretest": "npm run generate",
    "test": "vitest"
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "dependencies": {
    "flatbuffers": "^25.9.23",
    "geokdbush": "^2.0.1",
    "kdbush": "^4.0.2",
    "minisearch": "^7.2.0"
  },
  "devDependencies": {
    "@neaps/stations": "*",
    "@types/geokdbush": "^1.1.5",
    "@types/node": "^26.0.0",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "unplugin-macros": "^0.20.0",
    "vitest": "^4.0.15"
  }
}
