#!/bin/bash
# Regenerates the committed FlatBuffers accessors from schemas/database.fbs.
# Run after changing the schema; commit the result. CI fails when the
# generated code drifts from the schema.

set -e
cd "$(dirname "$0")"

out=src/main/kotlin/generated
rm -rf "$out"
flatc --kotlin -o "$out" ../../schemas/database.fbs

# Two edits flatc has no option for:
# - `internal`, so the accessors stay out of the library's public API.
# - Drop validateVersion(). It calls Constants.FLATBUFFERS_25_9_23(), which
#   only the 25.9.23 Java runtime defines, and that runtime was never published
#   to Maven Central. 25.2.10 is the newest there and differs from 25.9.23 only
#   in formatting and that marker. Nothing calls validateVersion().
find "$out" -name '*.kt' -exec perl -pi -e \
  's/^class /internal class /; $_ = "" if /fun validateVersion\(\)/' {} +
